{
  "name": "techbook-template",
  "version": "1.0.5",
  "description": "Vivliostyle を使用した技術書自動組版テンプレート",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-errata.mjs && node scripts/check-isdn.mjs && node scripts/check-preface-errata.mjs && node scripts/check-index.mjs && vivliostyle build && node scripts/add-line-numbers.mjs && vivliostyle build && node scripts/add-line-numbers.mjs --restore && node scripts/verify-build.mjs",
    "build:print": "node scripts/build-print.mjs",
    "build:cover": "node scripts/build-cover.mjs",
    "check:errata": "node scripts/check-errata.mjs",
    "check:isdn": "node scripts/check-isdn.mjs",
    "check:preface": "node scripts/check-preface-errata.mjs",
    "check:index": "node scripts/check-index.mjs",
    "check:icon-bake": "node scripts/check-icon-bake.mjs",
    "check:transparency": "node scripts/check-print-transparency.mjs",
    "gen:index": "node scripts/gen-index.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "vivliostyle preview",
    "build:samples": "vivliostyle build -c vivliostyle.design-samples.config.js",
    "preview:samples": "vivliostyle preview -c vivliostyle.design-samples.config.js",
    "clean": "rimraf dist src/chapters/*.html src/design-samples/*.html"
  },
  "devDependencies": {
    "@opendataloader/pdf": "^2.4.7",
    "@u1f992/rehype-spectroscope": "github:u1f992/rehype-spectroscope#v0.1.0",
    "@vivliostyle/cli": "^8.16.1",
    "rimraf": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
